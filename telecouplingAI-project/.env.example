GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MAX_CONCURRENT=8
GEMINI_MAX_QUEUE=500
GEMINI_INPUT_TPM_LIMIT=3000000
GEMINI_TPM_UTILIZATION=0.90
GEMINI_ESTIMATED_INPUT_TOKENS=45000
DIRECT_TOOL_COMPLETION_ENABLED=false
SSE_PING_SECONDS=10
RELEASE_VERSION=capacity-200-v2-direct-complete

# --- Paths (Docker container paths, do NOT use Windows paths) ---
SHARED_DIR=/data/outputs
UPLOADS_DIR=/data/uploads
FILE_SERVER_URL=http://file-server/download/

# --- QGIS (conda-forge install inside Docker) ---
QGIS_PYTHON_PATH=/opt/conda/envs/TeleCouplingAI/bin/python
QGIS_PREFIX_PATH=/opt/conda/envs/TeleCouplingAI
QGIS_MAX_CONCURRENT=3
QT_QPA_PLATFORM=offscreen

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- InVEST model data (mounted read-only in Docker) ---
MODEL_DATA_PATH=/data/model_data

# --- R scripts ---
R_SCRIPT_DIR=./r_scripts

# --- Session ---
SESSION_TTL_HOURS=24
SESSION_ACTIVE_LEASE_SECONDS=3600
MAX_SESSIONS=500
AUTH_REQUIRED=false

# --- Admin error registry ---
ERROR_REGISTRY_ENABLED=false
ADMIN_ENABLED=false
ERROR_ENVIRONMENT=local
ERROR_DB_HOST=error-db
POSTGRES_DB=csis_errors
POSTGRES_USER=csis_error
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ERROR_RETENTION_DAYS=90
ERROR_EVIDENCE_DIR=/data/error-evidence
ERROR_EVIDENCE_MAX_BYTES=2147483648
ADMIN_USERNAME=admin
# Generate with: python backend/scripts/hash_admin_password.py
ADMIN_PASSWORD_HASH=replace-with-generated-argon2id-hash
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_HOURS=8

# --- Gemini model ---
DEFAULT_MODEL=gemini-2.5-flash
