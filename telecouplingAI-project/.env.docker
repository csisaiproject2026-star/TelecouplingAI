# ============================================
# CSIS Platform — Docker Deployment Config
# ============================================
# This file is used by docker-compose for ALL services.
# NOTE: PROJ_DATA / GDAL_DATA / SSL_CERT_FILE / PYTHONPATH are now baked
#       into the Dockerfile as ENV instructions — no longer needed here.
#       Only app-level settings and HOST_* mount paths remain.
# ============================================

GOOGLE_API_KEY=AIzaSyDrYFbgOv_NtSPG7z5X4FT9zBb0OMYPWk4

# --- Container paths (Linux, inside containers) ---
SHARED_DIR=/data/outputs
UPLOADS_DIR=/data/uploads
FILE_SERVER_URL=http://file-server/download/

# --- QGIS ---
QGIS_PYTHON_PATH=/opt/conda/envs/TeleCouplingAI/bin/python
QGIS_MAX_CONCURRENT=3

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- InVEST model data (container path, mounted read-only) ---
MODEL_DATA_PATH=/data/model_data

# --- R scripts (container path) ---
R_SCRIPT_DIR=/app/r_scripts

# --- Session ---
SESSION_TTL_HOURS=24
MAX_SESSIONS=50
AUTH_REQUIRED=false

# --- Gemini model ---
DEFAULT_MODEL=gemini-2.5-flash

# --- Python path: app + QGIS bindings + QGIS plugins ---
# (also baked into Dockerfile ENV; remove this line after next image rebuild)
PYTHONPATH=/app:/opt/conda/envs/TeleCouplingAI/share/qgis/python:/opt/conda/envs/TeleCouplingAI/share/qgis/python/plugins

# ============================================
# HOST volume mount sources (Windows host paths → Docker Desktop)
# Use forward slashes. Docker Desktop maps C:/ → /c/ automatically.
# Change these when deploying to Linux (use absolute Linux paths).
# ============================================
HOST_SHARED_DIR=C:/YPHOME/Jianan_Projects/Telecoupling_AI_Project/fulldev/telecouplingAI-project/outputs
HOST_UPLOADS_DIR=C:/YPHOME/Jianan_Projects/Telecoupling_AI_Project/fulldev/telecouplingAI-project/uploads
HOST_MODEL_DATA_PATH=C:/YPHOME/Jianan_Projects/Telecoupling_AI_Project/fulldev/telecouplingAI-project/datainput_for_demo/CropProductionPercentile_input/model_data
