# ============================================================
# CSIS Platform — MSU Production Config
# Copy to .env.docker ON THE MSU SERVER (do not deploy/overwrite from local).
# DO NOT commit real secrets — keep GOOGLE_API_KEY a placeholder here.
# ============================================================

# --- AI ---
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MAX_CONCURRENT=8
GEMINI_MAX_QUEUE=500
GEMINI_INPUT_TPM_LIMIT=3000000
GEMINI_TPM_UTILIZATION=0.90
GEMINI_ESTIMATED_INPUT_TOKENS=45000
SSE_PING_SECONDS=10
RELEASE_VERSION=capacity-200-v1

# --- Public server URL (THE single per-server knob) ---
# Download links handed to users are derived from this: <base>/download/
# Use the public domain so links work for both campus-network (http://35.9.219.33/)
# and public (https://ai.telecoupling.msu.edu/, via MSU WAF) testers.
# Links go through the nginx /download/ proxy on 80/443 (NOT :8001).
SERVER_BASE_URL=https://ai.telecoupling.msu.edu

# --- Storage (paths INSIDE the container) ---
SHARED_DIR=/data/outputs
UPLOADS_DIR=/data/uploads

# --- QGIS (Linux inside Docker, set by Dockerfile ENV) ---
QGIS_PYTHON_PATH=/opt/conda/envs/TeleCouplingAI/bin/python
QGIS_MAX_CONCURRENT=3
QT_QPA_PLATFORM=offscreen
QGIS_PREFIX_PATH=/opt/conda/envs/TeleCouplingAI

# --- Redis (container name, Docker internal DNS) ---
REDIS_URL=redis://redis:6379/0

# --- InVEST model data (mounted read-only) ---
MODEL_DATA_PATH=/data/model_data

# --- R scripts ---
R_SCRIPT_DIR=./r_scripts

# --- Session ---
SESSION_TTL_HOURS=24
SESSION_ACTIVE_LEASE_SECONDS=3600
MAX_SESSIONS=500
AUTH_REQUIRED=false

# --- Gemini model ---
DEFAULT_MODEL=gemini-2.5-flash
